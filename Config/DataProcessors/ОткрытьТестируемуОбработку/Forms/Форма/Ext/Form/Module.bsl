&НаСервереБезКонтекста
Функция ПодключитьОбработку(Знач ИмяФайла)
	
	// Путь может прийти из параметра запуска (/C). Если он не задан,
	// берём значение константы, как было раньше.
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = Константы.ТестируемаяОбработка.Получить();
	КонецЕсли;
	
	Файл = Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение "Файл внешней обработки не найден";
	КонецЕсли;
	
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	// BSLLS:UsingExternalCodeTools-off
	Обработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОписаниеЗащиты);
	
	// Открываем сразу форму автотеста: форма Initialize разбирает режим запуска
	// по параметрам формы, но в .epf параметры не объявлены, поэтому платформа
	// не передаёт их в Параметры и признак автотеста до формы не доходит.
	МетаданныеОбработки = Обработка.Метаданные();
	ФормаАвтотеста = МетаданныеОбработки.Формы.Найти("AutotestRun");
	Если ФормаАвтотеста = Неопределено Тогда
		ВызватьИсключение "У тестируемой обработки нет формы AutotestRun";
	КонецЕсли;
	
	// Полное имя формы внешней обработки включает вид формы: без ".Форма."
	// платформа отвечает "Unknown form name" и форма не открывается.
	Возврат "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма." + ФормаАвтотеста.Имя;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ИмяНовойФормы = ПодключитьОбработку(ПараметрЗапуска);
	// Форме автотеста параметры не нужны: компоненту она берёт из макета,
	// каталог обработки — из Объект.ИспользуемоеИмяФайла.
	ОткрытьФорму(ИмяНовойФормы);
	
КонецПроцедуры
