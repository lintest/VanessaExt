&НаСервереБезКонтекста
Функция ПодключитьОбработку(Знач ИмяФормы)
	
	ЛогФайл = КаталогВременныхФайлов() + "ci-trace.log";

	// Путь к тестируемой обработке берём из константы, а если она не заполнена
	// (свежая база в CI) — из файла рядом с текущим каталогом.
	ИмяФайла = Константы.ТестируемаяОбработка.Получить();
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "VanessaExt.epf";
	КонецЕсли;
	
	Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку("прослойка: ПодключитьОбработку, ИмяФайла=" + ИмяФайла);
	Запись.Закрыть();

	Файл = Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("прослойка: ФАЙЛ НЕ НАЙДЕН: " + Файл.ПолноеИмя);
		Запись.Закрыть();
		ВызватьИсключение "Файл внешней обработки не найден: " + Файл.ПолноеИмя;
	КонецЕсли;
	
	// Загрузка через ВнешниеОбработки.Создать с отключёнными предупреждениями —
	// именно это убирает модальный диалог «Предупреждение безопасности», на
	// котором в headless-сессии клиент висел до таймаута при /Execute.
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	// Путь передаём полный. С относительным путём платформа оставляет
	// ИспользуемоеИмяФайла пустым, и в форме AutotestRun ТекущийКаталог
	// становится пустой строкой: trace.log, success.txt и поиск
	// распакованной .so уезжают в текущий каталог клиента, а CI их не находит.
	// BSLLS:UsingExternalCodeTools-off
	Обработка = ВнешниеОбработки.Создать(Файл.ПолноеИмя, Ложь, ОписаниеЗащиты);
	
	МетаданныеОбработки = Обработка.Метаданные();
	ОсновнаяФорма = МетаданныеОбработки.ОсновнаяФорма;
	
	Если Не ПустаяСтрока(ИмяФормы) Тогда
		// Форма задана явно. В режиме автотеста открываем AutotestRun сразу,
		// минуя Initialize: открытие второй формы обработки из обработчика
		// (и из обработчика ожидания) платформа не доводит до конца — главный
		// поток застревает во вложенной обработке idle-событий и клиент висит
		// до таймаута (стек прогона 66). Глубина открытия здесь ровно та же,
		// на которой Initialize открывается штатно.
		ИмяНовойФормы = "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма." + ИмяФормы;
	ИначеЕсли ОсновнаяФорма = Неопределено Тогда
		ИмяНовойФормы = "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма";
	Иначе
		// Без ".Форма." платформа отвечает "Unknown form name" и форма не откроется.
		ИмяНовойФормы = "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма." + ОсновнаяФорма.Имя;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку("прослойка: ПодключитьОбработку -> ИмяОбработки=" + МетаданныеОбработки.Имя
		+ ", ОсновнаяФорма=" + ?(ОсновнаяФорма = Неопределено, "<не задана>", ОсновнаяФорма.Имя)
		+ ", ИмяНовойФормы=" + ИмяНовойФормы);
	Запись.Закрыть();

	Возврат ИмяНовойФормы;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормы(Знач Режим)
	
	ИмяФайлаБиблиотеки = Константы.ТестируемаяБиблиотека.Получить();
	// Ключ «РежимЗапускаФормы» — имя параметра, объявленного в форме Initialize
	// обработки Example. Необъявленные ключи платформа в Параметры не передаёт.
	Возврат Новый Структура("AddInURL,РежимЗапускаФормы", ИмяФайлаБиблиотеки, Режим);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Прослойка нужна только чтобы открыть тестируемую обработку программно:
	// при /Execute платформа показывает диалог безопасности и клиент висит.
	// Режим (install / autotest) приходит параметром формы из модуля приложения
	// и передаётся дальше в форму обработки — ПараметрЗапуска в модуле формы
	// недоступен.
	// Отказ ставится в конце обработчика, а не в начале: форма прослойки всё
	// равно закрывается, но вложенное открытие формы обработки из обработчика,
	// где форма уже помечена как отменённая, платформа до конца не доводит —
	// клиент висит на ОткрытьФорму до таймаута.
	ЛогФайл = КаталогВременныхФайлов() + "ci-trace.log";
	Режим = "";
	ИсточникРежима = "";
	
	// Параметр формы работает только если он объявлен в метаданных формы
	// (блок Parameters в Form.xml). Ошибку не глотаем: раньше пустое значение
	// молча уводило прогон в интерактивную ветку, и клиент висел до таймаута.
	Попытка
		Если Параметры.Свойство("РежимЗапуска", Режим) И Не ПустаяСтрока(Режим) Тогда
			ИсточникРежима = "параметр формы";
		Иначе
			Режим = "";
		КонецЕсли;
	Исключение
		ИсточникРежима = "ошибка чтения параметра формы: " + ОписаниеОшибки();
	КонецПопытки;
	
	// Страховка: ПараметрЗапуска — свойство глобального контекста, доступное на
	// клиенте, в том числе в модуле формы. В CI там ровно то, что передали в /C.
	Если ПустаяСтрока(Режим) Тогда
		Попытка
			Режим = ПараметрЗапуска;
			ИсточникРежима = ИсточникРежима + "; взят ПараметрЗапуска";
		Исключение
			ИсточникРежима = ИсточникРежима + "; ПараметрЗапуска недоступен";
		КонецПопытки;
	КонецЕсли;
	
	ЗаписатьВЛог(ЛогФайл, "прослойка: ПриОткрытии, Режим=" + Режим + " (" + ИсточникРежима + ")");
	
	// Открываем главную форму обработки (Initialize): именно она пересекает
	// границу конфигурация -> внешняя обработка штатно. AutotestRun дальше
	// берётся из Initialize через ПолучитьФорму, без ОткрытьФорму: показ
	// второй формы обработки из конфигурации вешает клиент (стеки 66-69).
	ИмяФормыДляОткрытия = "";
	Попытка
		ИмяНовойФормы = ПодключитьОбработку(ИмяФормыДляОткрытия);
	Исключение
		ЗаписатьВЛог(ЛогФайл, "прослойка: ПодключитьОбработку - ОШИБКА: " + ОписаниеОшибки());
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	// Маркер ставится ДО вызова: если клиент зависнет внутри ОткрытьФорму,
	// в логе останется последняя точка входа, а не пустота.
	ЗаписатьВЛог(ЛогФайл, "прослойка: ОткрытьФорму(" + ИмяНовойФормы + ") - вызов");
	Попытка
		ОткрытьФорму(ИмяНовойФормы, ПолучитьПараметрыФормы(Режим));
		ЗаписатьВЛог(ЛогФайл, "прослойка: ОткрытьФорму(" + ИмяНовойФормы + ") - ок");
	Исключение
		ЗаписатьВЛог(ЛогФайл, "прослойка: ОткрытьФорму(" + ИмяНовойФормы + ") - ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Только теперь: см. комментарий в начале обработчика.
	Отказ = Истина;
	ЗаписатьВЛог(ЛогФайл, "прослойка: ПриОткрытии завершён");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВЛог(Знач ЛогФайл, Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Текст);
		Запись.Закрыть();
	Исключение
		// Диагностический лог не должен ломать прогон: если файл недоступен,
		// просто выходим, не прерывая открытие формы.
		Возврат;
	КонецПопытки;
	
КонецПроцедуры
