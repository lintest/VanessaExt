&НаСервереБезКонтекста
Функция ПодключитьОбработку(Знач ИмяФайла)
	
	ЛогФайл = КаталогВременныхФайлов() + "ci-trace.log";

	// Путь к тестируемой обработке берём из константы, а если она не заполнена
	// (свежая база в CI) — из файла рядом с текущим каталогом.
	ИмяФайла = Константы.ТестируемаяОбработка.Получить();
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "VanessaExt.epf";
	КонецЕсли;
	
	Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку("прослойка: ПодключитьОбработку, ИмяФайла=" + ИмяФайла);
	Запись.Закрыть();

	Файл = Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("прослойка: ФАЙЛ НЕ НАЙДЕН: " + Файл.ПолноеИмя);
		Запись.Закрыть();
		ВызватьИсключение "Файл внешней обработки не найден: " + Файл.ПолноеИмя;
	КонецЕсли;
	
	// Загрузка через ВнешниеОбработки.Создать с отключёнными предупреждениями —
	// именно это убирает модальный диалог «Предупреждение безопасности», на
	// котором в headless-сессии клиент висел до таймаута при /Execute.
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	// BSLLS:UsingExternalCodeTools-off
	Обработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОписаниеЗащиты);
	
	МетаданныеОбработки = Обработка.Метаданные();
	ОсновнаяФорма = МетаданныеОбработки.ОсновнаяФорма;
	
	Если ОсновнаяФорма = Неопределено Тогда
		ИмяНовойФормы = "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма";
	Иначе
		// Без ".Форма." платформа отвечает "Unknown form name" и форма не откроется.
		ИмяНовойФормы = "ВнешняяОбработка." + МетаданныеОбработки.Имя + ".Форма." + ОсновнаяФорма.Имя;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку("прослойка: ПодключитьОбработку -> ИмяОбработки=" + МетаданныеОбработки.Имя
		+ ", ОсновнаяФорма=" + ?(ОсновнаяФорма = Неопределено, "<не задана>", ОсновнаяФорма.Имя)
		+ ", ИмяНовойФормы=" + ИмяНовойФормы);
	Запись.Закрыть();

	Возврат ИмяНовойФормы;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормы(Знач Режим)
	
	ИмяФайлаБиблиотеки = Константы.ТестируемаяБиблиотека.Получить();
	Возврат Новый Структура("AddInURL,РежимЗапуска", ИмяФайлаБиблиотеки, Режим);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Прослойка нужна только чтобы открыть тестируемую обработку программно:
	// при /Execute платформа показывает диалог безопасности и клиент висит.
	// Режим (install / autotest) приходит параметром формы из модуля приложения
	// и передаётся дальше в форму обработки — ПараметрЗапуска в модуле формы
	// недоступен.
	Отказ = Истина;
	Режим = "";
	Попытка
		Параметры.Свойство("РежимЗапуска", Режим);
	Исключение
		Режим = "";
	КонецПопытки;

	ЛогФайл = КаталогВременныхФайлов() + "ci-trace.log";
	Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку("прослойка: ПриОткрытии, Режим=" + Режим);
	Запись.Закрыть();

	Попытка
		ИмяНовойФормы = ПодключитьОбработку("");
	Исключение
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("прослойка: ПодключитьОбработку — ОШИБКА: " + ОписаниеОшибки());
		Запись.Закрыть();
		Возврат;
	КонецПопытки;

	Попытка
		ОткрытьФорму(ИмяНовойФормы, ПолучитьПараметрыФормы(Режим));
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("прослойка: ОткрытьФорму(" + ИмяНовойФормы + ") — ок");
		Запись.Закрыть();
	Исключение
		Запись = Новый ЗаписьТекста(ЛогФайл, КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("прослойка: ОткрытьФорму(" + ИмяНовойФормы + ") — ОШИБКА: " + ОписаниеОшибки());
		Запись.Закрыть();
	КонецПопытки;
	
КонецПроцедуры
