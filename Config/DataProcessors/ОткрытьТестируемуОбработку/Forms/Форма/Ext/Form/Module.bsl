&НаСервереБезКонтекста
Функция ПодключитьОбработку(Знач ИмяФайла)
	
	// Путь может прийти из параметра запуска (/C). Если он не задан,
	// берём значение константы, как было раньше.
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = Константы.ТестируемаяОбработка.Получить();
	КонецЕсли;
	
	Файл = Новый Файл(ИмяФайла);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение "Файл внешней обработки не найден";
	КонецЕсли;
	
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	// BSLLS:UsingExternalCodeTools-off
	Обработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОписаниеЗащиты);
	
	// Форму берём по имени основной формы обработки: в ней разбирается режим
	// запуска (install / autotest / демо).
	МетаданныеОбработки = Обработка.Метаданные();
	ОсновнаяФорма = МетаданныеОбработки.ОсновнаяФорма;
	Если ОсновнаяФорма = Неопределено Тогда
		ВызватьИсключение "У внешней обработки не задана основная форма";
	КонецЕсли;
	
	Возврат "ВнешняяОбработка." + МетаданныеОбработки.Имя + "." + ОсновнаяФорма.Имя;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	ИмяНовойФормы = ПодключитьОбработку(ПараметрЗапуска);
	// ПараметрЗапуска занят путём к .epf, поэтому режим передаём параметром формы.
	// Компонента поставляется внутри .epf (макет VanessaExt), путь к библиотеке
	// не передаём, форма возьмёт её из макета.
	ПараметрыФормы = Новый Структура("Автотестирование", Истина);
	ОткрытьФорму(ИмяНовойФормы, ПараметрыФормы);
	
КонецПроцедуры
