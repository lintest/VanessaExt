#Если ТонкийКлиент Тогда
Процедура ПриНачалеРаботыСистемы()
	
	Если ПараметрЗапуска = "prepare" Тогда
		ПодготовитьБазуДляАвтотестов();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;
	
	// Тесты открывают обработку программно, а не через /Execute: платформа не
	// загружает внешний код сама, поэтому диалог «Предупреждение безопасности»
	// не появляется.
	Если ПараметрЗапуска = "install" Или ПараметрЗапуска = "autotest" Тогда
		ОткрытьТестируемуюОбработку();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ПараметрЗапуска) Тогда
		ОткрытьФорму("Обработка.ОткрытьТестируемуОбработку.Форма");
	КонецЕсли;
	
КонецПроцедуры

// Открывает тестируемую внешнюю обработку без диалога «Предупреждение безопасности».
// Обработка загружается методом ВнешниеОбработки.Создать с описанием защиты, где
// предупреждения отключены, поэтому платформа не спрашивает разрешение на загрузку
// внешнего кода.
&НаСервере
Процедура ОткрытьТестируемуюОбработку()
	
	ПараметрыФормы = Новый Структура("AddInURL", Константы.ТестируемаяБиблиотека.Получить());
	ОткрытьФорму(ИмяФормыТестируемойОбработки(), ПараметрыФормы);
	
КонецПроцедуры

// Загружает внешнюю обработку из файла и возвращает имя её формы Initialize —
// точки входа, которая по ПараметрЗапуска выполняет установку компоненты или
// запускает автотесты.
&НаСервереБезКонтекста
Функция ИмяФормыТестируемойОбработки()
	
	ИмяФайла = Константы.ТестируемаяОбработка.Получить();
	Если ПустаяСтрока(ИмяФайла) Тогда
		// В CI клиент стартует из каталога проекта, где лежит собранная обработка.
		ИмяФайла = "VanessaExt.epf";
	КонецЕсли;
	
	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение "Файл внешней обработки не найден: " + Файл.ПолноеИмя;
	КонецЕсли;
	
	ОписаниеЗащиты = Новый ОписаниеЗащитыОтОпасныхДействий;
	ОписаниеЗащиты.ПредупреждатьОбОпасныхДействиях = Ложь;
	
	// BSLLS:UsingExternalCodeTools-off
	Обработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОписаниеЗащиты);
	
	Возврат "ВнешняяОбработка." + Обработка.Метаданные().Имя + ".Initialize";
	
КонецФункции

// Готовит базу к автотестам: заводит пользователя CI с правами администратора и
// отключает предупреждения о загрузке внешнего кода у всех пользователей базы.
//
// Настройка хранится в самой информационной базе и действует во всех последующих
// сеансах. Вызывается в CI до тестов: клиент стартует с параметром /C prepare,
// готовит базу и завершается.
&НаСервере
Процедура ПодготовитьБазуДляАвтотестов()
	
	ИмяПользователя = "CI";
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
		Пользователь.Имя = ИмяПользователя;
	КонецЕсли;
	
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если Роль.Имя = "Administrator" И Не Пользователь.Роли.Содержит(Роль) Тогда
			Пользователь.Роли.Добавить(Роль);
		КонецЕсли;
	КонецЦикла;
	
	Пользователь.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	Пользователь.Записать();
	
	Для Каждого ОписаниеПользователя Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если ОписаниеПользователя.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях Тогда
			ОписаниеПользователя.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
			ОписаниеПользователя.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
#КонецЕсли
