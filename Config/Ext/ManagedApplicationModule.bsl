#Если ТонкийКлиент Тогда
Процедура ПриНачалеРаботыСистемы()
	
	Если ПараметрЗапуска = "prepare" Тогда
		ПодготовитьПользователяБезПредупреждений();
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ПараметрЗапуска) Тогда
		ОткрытьФорму("Обработка.ОткрытьТестируемуОбработку.Форма");
	КонецЕсли;
	
КонецПроцедуры

// Готовит пользователя для автотестов: под ним 1С не показывает предупреждение
// безопасности при загрузке внешних обработок.
//
// Используется в CI перед запуском тестов: клиент стартует с параметром /C prepare,
// создаёт пользователя CI и завершается. Дальше install и autotest выполняются
// под этим пользователем (/N CI), поэтому диалог загрузки внешней обработки
// не появляется и сеанс не зависает.
//
&НаСервере
Процедура ПодготовитьПользователяБезПредупреждений()
	
	ИмяПользователя = "CI";
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
		Пользователь.Имя = ИмяПользователя;
	КонецЕсли;
	
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если Роль.Имя = "Administrator" И Не Пользователь.Роли.Содержит(Роль) Тогда
			Пользователь.Роли.Добавить(Роль);
		КонецЕсли;
	КонецЦикла;
	
	Пользователь.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	Пользователь.Записать();
	
КонецПроцедуры
#КонецЕсли
