// Автотесты VanessaExt под OneScript.
//
// Зачем: OneScript — независимая реализация виртуальной машины языка 1С без
// платформы 1С и без GUI. Ей достаточно нативной внешней компоненты
// (ScriptEngine.NativeApi), поэтому тесты компоненты можно гонять на любом
// раннере, включая windows-latest, где нет интерактивной сессии.
//
// Что делает раннер:
//   1. находит и подключает собранную библиотеку (VanessaExt*Win64.dll,
//      VanessaExt*Lin64.so и т.д.);
//   2. загружает существующие модули тестов (Example/Forms/xUnitBDD и
//      Example/Forms/Autotests), вырезав директивы компиляции &НаКлиенте и
//      &НаСервере — OneScript их не поддерживает;
//   3. играет роль владельца тестов, то есть реализует те же методы, что
//      форма Example/Forms/AppVeyor (Добавить, ДобавитьШаг, ЗаписатьПроблему,
//      ПрерватьТест);
//   4. прогоняет набор и завершается с ненулевым кодом, если были ошибки.
//
// Запуск из корня репозитория (важно: пути к keywords.json и картинкам
// отсчитываются от текущего каталога):
//   oscript tests/oscript/runner.os
//   oscript tests/oscript/runner.os --библиотека=bin64/VanessaExtLin64.so

Перем НаборТестов;
Перем ИдентификаторКомпоненты;
Перем ТекущийТест;

// Признак для набора тестов: гоняем вне платформы 1С, часть тестов недоступна.
Перем ВнеПлатформы1С Экспорт;

Перем Всего;
Перем Пройдено;
Перем Провалено;

// Возвращает истину, если раннер запущен на Linux. Проверка не требует
// платформенных объектов и работает в любой среде.
Функция ЭтоЛинукс()
	Возврат Новый Файл("/proc/self/status").Существует();
КонецФункции

// Путь к собранной библиотеке: из параметра --библиотека либо автопоиск
// по типовым каталогам сборки (CMake кладёт результат в bin32/bin64).
Функция НайтиБиблиотеку()
	
	ПутьИзПараметров = "";
	Попытка
		Параметры = Вычислить("ПараметрыСкрипта");
		Если Параметры <> Неопределено Тогда
			Значение = Параметры.Получить("библиотека");
			Если Значение <> Неопределено Тогда
				ПутьИзПараметров = Значение;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПутьИзПараметров = "";
	КонецПопытки;
	
	Если Не ПустаяСтрока(ПутьИзПараметров) Тогда
		Файл = Новый Файл(ПутьИзПараметров);
		Если Не Файл.Существует() Тогда
			ВызватьИсключение "Не найдена библиотека по пути: " + ПутьИзПараметров;
		КонецЕсли;
		Возврат Файл.ПолноеИмя;
	КонецЕсли;
	
	// Пары "каталог|маска": на Windows dll лежит в подкаталоге конфигурации.
	// Каталог libs — это распакованный AddIn.zip в CI, его проверяем первым.
	Варианты = Новый Массив;
	Если ЭтоЛинукс() Тогда
		Варианты.Добавить("libs|*Lin64.so");
		Варианты.Добавить("libs|*Lin32.so");
		Варианты.Добавить("bin64|*Lin64.so");
		Варианты.Добавить("bin32|*Lin32.so");
	Иначе
		Варианты.Добавить("libs|*Win64.dll");
		Варианты.Добавить("libs|*Win32.dll");
		Варианты.Добавить("bin64\Release|*Win64.dll");
		Варианты.Добавить("bin64|*Win64.dll");
		Варианты.Добавить("bin32\Release|*Win32.dll");
		Варианты.Добавить("bin32|*Win32.dll");
	КонецЕсли;
	
	Для каждого Вариант Из Варианты Цикл
		Части = СтрРазделить(Вариант, "|", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Каталог = Новый Файл(Части[0]);
		Если Не Каталог.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Найденные = НайтиФайлы(Части[0], Части[1], Ложь);
		Если Найденные.Количество() > 0 Тогда
			Возврат Найденные[0].ПолноеИмя;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение "Не найдена собранная библиотека VanessaExt. Соберите проект или укажите --библиотека=<путь>";
	
КонецФункции

// Подключение нативной внешней компоненты. ТипВнешнейКомпоненты в OneScript
// может отсутствовать, поэтому обращение идёт через Вычислить.
Процедура ПодключитьКомпоненту()
	
	Путь = НайтиБиблиотеку();
	ИдентификаторКомпоненты = "_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	
	Сообщить("Библиотека: " + Путь);
	Сообщить("Идентификатор компоненты: " + ИдентификаторКомпоненты);
	
	ТипКомпоненты = Вычислить("ТипВнешнейКомпоненты.Native");
	ПодключитьВнешнююКомпоненту(Путь, ИдентификаторКомпоненты, ТипКомпоненты);
	
КонецПроцедуры

// Директивы компиляции — особенность платформы 1С; в OneScript их нет.
Функция ЭтоДиректива(Строка)
	
	Обрезанная = СокрЛП(Строка);
	Возврат Лев(Обрезанная, 10) = "&НаКлиенте"
		ИЛИ Лев(Обрезанная, 10) = "&НаСервере";
	
КонецФункции

// Загружает модуль формы как сценарий OneScript, вырезая директивы.
// Остальной код модулей специально написан так, чтобы компилироваться в
// OneScript: платформенные вызовы спрятаны в Вычислить.
Процедура ЗагрузитьМодуль(Путь, ИмяМодуля)
	
	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение "Не найден модуль тестов: " + Путь;
	КонецЕсли;
	
	Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	
	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Очищенный = "";
	Для каждого Строка Из Строки Цикл
		Если ЭтоДиректива(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Очищенный = Очищенный + Строка + Символы.ПС;
	КонецЦикла;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла() + ".bsl";
	Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	Запись.Записать(Очищенный);
	Запись.Закрыть();
	
	ПодключитьСценарий(ВременныйФайл, ИмяМодуля);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

Процедура ЗагрузитьМодули()
	
	ЗагрузитьМодуль("Example/Forms/xUnitBDD/Ext/Form/Module.bsl", "xUnitBDD");
	ЗагрузитьМодуль("Example/Forms/Autotests/Ext/Form/Module.bsl", "Autotests");
	
КонецПроцедуры

// --- Реализация владельца тестов (как у формы AppVeyor) -------------------

Процедура Добавить(Знач ИмяМетода, Знач Представление) Экспорт
	
	НаборТестов.Вставить(Представление, ИмяМетода);
	
КонецПроцедуры

Функция ДобавитьШаг(ТекущаяГруппа, Представление) Экспорт
	
	Возврат Новый Структура("Наименование,Результат,Эталон", Представление);
	
КонецФункции

Функция ЗаписатьПроблему(ТекущаяГруппа, ТекущаяСтрока, ТекстПроблемы) Экспорт
	
	Наименование = "Неизвестный шаг";
	Если ТекущаяСтрока <> Неопределено Тогда
		Наименование = ТекущаяСтрока.Наименование;
	КонецЕсли;
	ЗапомнитьПроблему("ПРОБЛЕМА: " + Наименование + " - " + Строка(ТекстПроблемы));
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ПрерватьТест(ТекущаяГруппа, ТекущаяСтрока, Результат, Подробности) Экспорт
	
	Наименование = "Неизвестный шаг";
	Если ТекущаяСтрока <> Неопределено Тогда
		Наименование = ТекущаяСтрока.Наименование;
	КонецЕсли;
	ЗапомнитьПроблему("ОШИБКА: " + Наименование + " - " + Строка(Подробности) + " " + Строка(Результат));
	Возврат ЭтотОбъект;
	
КонецФункции

Процедура ЗапомнитьПроблему(Текст)
	
	Если ТекущийТест = Неопределено Тогда
		Сообщить(Текст);
		Возврат;
	КонецЕсли;
	ТекущийТест.Проблемы.Добавить(Текст);
	ТекущийТест.Ошибка = Истина;
	
КонецПроцедуры

// --- Прогон ---------------------------------------------------------------

Процедура ВыполнитьТесты()
	
	НаборТестов = Новый Соответствие;
	Всего = 0;
	Пройдено = 0;
	Провалено = 0;
	ТекущийТест = Неопределено;
	ВнеПлатформы1С = Истина;
	
	ПодключитьКомпоненту();
	ЗагрузитьМодули();
	
	Автотесты = Новый("Autotests");
	Автотесты.ЗаполнитьНаборТестов(ЭтотОбъект);
	
	Сообщить("Тестов в наборе: " + НаборТестов.Количество());
	Сообщить("");
	
	Для каждого ЭлементСписка Из НаборТестов Цикл
		
		Всего = Всего + 1;
		
		ТекущийТест = Новый Структура;
		ТекущийТест.Вставить("Наименование", ЭлементСписка.Ключ);
		ТекущийТест.Вставить("ИмяМетода", ЭлементСписка.Значение);
		ТекущийТест.Вставить("Проблемы", Новый Массив);
		ТекущийТест.Вставить("Ошибка", Ложь);
		
		xUnitBDD = Новый("xUnitBDD");
		xUnitBDD.Инициализация(ЭтотОбъект, ИдентификаторКомпоненты, ТекущийТест);
		
		Попытка
			Выполнить("Автотесты." + ТекущийТест.ИмяМетода + "(xUnitBDD)");
		Исключение
			Информация = ИнформацияОбОшибке();
			ТекущийТест.Ошибка = Истина;
			ТекущийТест.Проблемы.Добавить("Исключение: " + КраткоеПредставлениеОшибки(Информация));
		КонецПопытки;
		
		Если ТекущийТест.Ошибка Тогда
			Провалено = Провалено + 1;
			Сообщить("ОШИБКА: " + ТекущийТест.Наименование);
			Для каждого Проблема Из ТекущийТест.Проблемы Цикл
				Сообщить("    " + Проблема);
			КонецЦикла;
		Иначе
			Пройдено = Пройдено + 1;
			Сообщить("УСПЕШНО: " + ТекущийТест.Наименование);
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("");
	Сообщить("Всего: " + Всего + ", пройдено: " + Пройдено + ", провалено: " + Провалено);
	
	Если Провалено > 0 Тогда
		ВызватьИсключение "Автотесты не пройдены: " + Провалено + " из " + Всего;
	КонецЕсли;
	
КонецПроцедуры

ВыполнитьТесты();
