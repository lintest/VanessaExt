// Диагностика NativeApi: что реально возвращает компонента в OneScript.
//
// Зачем: в наборе автотестов методы, возвращающие JSON-строку, дают пустое
// значение, а свойства с числами работают. Скрипт печатает тип и содержимое
// результата, чтобы понять, где теряется строка: в компоненте, в прокси
// NativeApi или в разборе JSON.
//
// Запуск из корня репозитория:
//   oscript tests/oscript/probe.os --библиотека=libs/VanessaExtLin64.so

Перем ИдентификаторКомпоненты;

Функция ЭтоЛинукс()
	Возврат Новый Файл("/proc/self/status").Существует();
КонецФункции

Функция НайтиБиблиотеку()
	
	Попытка
		Параметры = Вычислить("ПараметрыСкрипта");
		Если Параметры <> Неопределено Тогда
			Значение = Параметры.Получить("библиотека");
			Если Значение <> Неопределено Тогда
				Возврат Новый Файл(Значение).ПолноеИмя;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ЭтоЛинукс() Тогда
		Маска = "libs/*Lin64.so";
	Иначе
		Маска = "libs/*Win64.dll";
	КонецЕсли;
	
	Найденные = НайтиФайлы("libs", СтрЗаменить(Маска, "libs/", ""), Ложь);
	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение "Не найдена библиотека";
	КонецЕсли;
	
	Возврат Найденные[0].ПолноеИмя;
	
КонецФункции

Процедура Вывести(Заголовок, Значение)
	
	Сообщить("--- " + Заголовок);
	Попытка
		Сообщить("    тип: " + ТипЗнч(Значение));
	Исключение
		Сообщить("    тип: не удалось получить");
	КонецПопытки;
	Попытка
		Текст = Строка(Значение);
		Сообщить("    длина строки: " + СтрДлина(Текст));
		Сообщить("    начало: " + Лев(Текст, 200));
	Исключение
		Сообщить("    строку получить не удалось");
	КонецПопытки;
	
КонецПроцедуры

Путь = НайтиБиблиотеку();
Сообщить("Библиотека: " + Путь);

ИдентификаторКомпоненты = "_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
ПодключитьВнешнююКомпоненту(Путь, ИдентификаторКомпоненты, Вычислить("ТипВнешнейКомпоненты.Native"));

ВК = Новый("AddIn." + ИдентификаторКомпоненты + ".WindowsControl");

// Свойство с числом: по логам работает.
Попытка
	Вывести("СвободноеМестоНаДиске", ВК.СвободноеМестоНаДиске("."));
Исключение
	Сообщить("--- СвободноеМестоНаДиске: исключение " + ОписаниеОшибки());
КонецПопытки;

// Метод, возвращающий JSON-строку: по логам приходит пусто.
Попытка
	Результат = ВК.НайтиФайлы(".", "*.*");
	Вывести("НайтиФайлы", Результат);
Исключение
	Сообщить("--- НайтиФайлы: исключение " + ОписаниеОшибки());
КонецПопытки;

// Тот же метод, но все параметры переданы явно. Гипотеза: OneScript не
// подставляет значения по умолчанию из описания метода, поэтому вызов с
// меньшим числом аргументов упирается в bad_function_call и метод молча
// возвращает Undefined.
Попытка
	Вывести("НайтиФайлы (все параметры)", ВК.НайтиФайлы(".", "*.*", "", Истина, Истина, Ложь));
Исключение
	Сообщить("--- НайтиФайлы (все параметры): исключение " + ОписаниеОшибки());
КонецПопытки;

// Второй класс: методы тоже объявлены с параметрами по умолчанию.
Попытка
	Геркин = Новый("AddIn." + ИдентификаторКомпоненты + ".GherkinParser");
	Вывести("ПрочитатьФайл (1 параметр)", Геркин.ПрочитатьФайл("README.md"));
Исключение
	Сообщить("--- ПрочитатьФайл (1 параметр): исключение " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Вывести("ПрочитатьФайл (2 параметра)", Геркин.ПрочитатьФайл("README.md", "."));
Исключение
	Сообщить("--- ПрочитатьФайл (2 параметра): исключение " + ОписаниеОшибки());
КонецПопытки;

// Второй метод со строкой на случай, если дело в конкретном методе.
Попытка
	Вывести("Версия", ВК.Версия);
Исключение
	Сообщить("--- Версия: исключение " + ОписаниеОшибки());
КонецПопытки;
