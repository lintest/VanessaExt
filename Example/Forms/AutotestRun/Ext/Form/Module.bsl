&НаКлиенте
Перем ИдентификаторКомпоненты, HTTPСоединение, НаборТестов;

&НаКлиенте
Перем ЕстьПроблема, ЕстьОшибка, ЕстьОшибкиПроблемы;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаписатьМаркерСервер("ПриСозданииНаСервере, старт");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗаписатьМаркерСервер("объект обработки получен");
	
	ФайлОбработки = Новый Файл(ОбработкаОбъект.ИспользуемоеИмяФайла);
	ИмяФайлаОбработки = ФайлОбработки.Имя;
	ТекущийКаталог = ФайлОбработки.Путь;
	ЗаписатьМаркерСервер("каталог обработки: " + ТекущийКаталог);
	
	// Штатный путь — адрес во временном хранилище. На Linux он не работает:
	// оповещение НачатьПодключениеВнешнейКомпоненты не вызывается вообще,
	// клиент висит до таймаута (проверено маркерами в CI). Поэтому макет
	// выкладываем файлом рядом с обработкой и подключаем по пути. Если файл
	// записать нельзя (клиент-серверный вариант), остаётся хранилище.
	//
	// Под Linux макет не нужен вовсе: ПриОткрытии подменяет местоположение на
	// путь к распакованной .so (addin/ рядом с обработкой). Раньше 30 МБ
	// читались из обработки, клались в хранилище и писались в файл — и всё это
	// выбрасывалось. Теперь на Linux шаг пропускается.
	Если ЭтоЛинуксСервер() Тогда
		МестоположениеКомпоненты = "";
		ЗаписатьМаркерСервер("Linux: макет компоненты не выгружаю");
		Возврат;
	КонецЕсли;
	
	ЗаписатьМаркерСервер("получаю макет VanessaExt");
	МакетКомпоненты = ОбработкаОбъект.ПолучитьМакет("VanessaExt");
	ЗаписатьМаркерСервер("макет получен");
	МестоположениеКомпоненты = ПоместитьВоВременноеХранилище(МакетКомпоненты, УникальныйИдентификатор);
	ЗаписатьМаркерСервер("макет помещён во временное хранилище");
	Попытка
		ПутьФайлаКомпоненты = ТекущийКаталог + ИмяФайлаОбработки + ".AddIn.zip";
		МакетКомпоненты.Записать(ПутьФайлаКомпоненты);
		МестоположениеКомпоненты = ПутьФайлаКомпоненты;
		ЗаписатьМаркерСервер("макет записан: " + ПутьФайлаКомпоненты);
	Исключение
		// Остаётся адрес временного хранилища.
		ПутьФайлаКомпоненты = "";
		ЗаписатьМаркерСервер("макет записать не удалось, остаётся хранилище");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ЭтоЛинуксСервер()
	
	Попытка
		Возврат СтрНайти(Строка(СистемнаяИнформация.ТипПлатформы), "Linux") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ЗаписатьМаркерСервер(Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "ci-trace.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("autotestrun: " + Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаписатьМаркер("ПриОткрытии, местоположение=" + Строка(МестоположениеКомпоненты));
	// Прямой путь к распакованной библиотеке. Подключение файла .so/.dll не
	// требует разбора бандла (manifest.xml) и установки в ExtCompT — а под
	// Linux виснет именно установка из бандла: реестр внешних компонент
	// остаётся пустым, оповещение не вызывается. CI-скрипт распаковывает
	// AddIn.zip рядом с обработкой и пишет путь в addin_path.txt.
	// Читаем на клиенте и в Попытке: сбой чтения не должен мешать открытию
	// формы, иначе клиент встанет ещё до первого маркера.
	// Признак платформы пишем в маркер: раньше ветку выбирала только проверка
	// файла, и её молчаливый отказ уводил прогон в асинхронное подключение,
	// где клиент висел до таймаута без единого сообщения.
	ЗаписатьМаркер("признак Linux: " + Строка(ЭтоЛинукс()));
	// Подменять местоположение на путь к файлу можно только под Linux: там
	// подключение из бандла не работает. На Windows оставляем штатный путь
	// через временное хранилище — именно он даёт зелёный прогон в AppVeyor,
	// и менять его в CI незачем.
	Если ЭтоЛинукс() Тогда
		МестоположениеКомпоненты = ПутьБиблиотекиИзФайла(МестоположениеКомпоненты);
	КонецЕсли;
	ЗаписатьМаркер("файл компоненты: " + ОписаниеФайлаКомпоненты());
	ИдентификаторКомпоненты = "_" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	
	Если ЭтоЛинукс() Тогда
		// Под Linux подключение из бандла не работает: оповещение
		// НачатьПодключениеВнешнейКомпоненты не вызывается, клиент висит до
		// таймаута. Поэтому там только синхронное подключение по прямому пути
		// к библиотеке — оно при неудаче возвращает текст ошибки. В
		// асинхронную ветку не уходим: она гарантированно виснет, и причина
		// отказа теряется. Ошибку уже записал ПодключитьСинхронно.
		Если ПодключитьСинхронно() Тогда
			ЗапуститьТесты();
		Иначе
			ЗаписатьМаркер("стоп: синхронное подключение не удалось, асинхронное под Linux не работает");
			ЗавершитьРаботуСистемы(Ложь);
		КонецЕсли;
	Иначе
		// Windows: прежний асинхронный путь с установкой из бандла.
		ЗапуститьСторож();
		ВыполнитьПодключениеВнешнейКомпоненты(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоЛинукс()
	
	// Определяем по типу платформы, а не по наличию файла: проверка
	// Файл("/proc/self/status").Существует() на Linux вернула Ложь (файл
	// нулевого размера), и прогон уходил в асинхронную ветку. Тип платформы —
	// единственный признак, который не зависит от прав и особенностей ФС.
	Попытка
		Если СтрНайти(Строка(СистемнаяИнформация.ТипПлатформы), "Linux") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Свойство может отсутствовать — падаем на проверки по файлам.
	КонецПопытки;
	
	// Страховка: /etc/os-release есть на любом дистрибутиве Linux и имеет
	// ненулевой размер, в отличие от файлов /proc.
	Попытка
		// Метод у выражения "Новый" в 1С вызвать нельзя — только через
		// переменную, иначе "Unknown operator" при инициализации модуля.
		Файл = Новый Файл("/etc/os-release");
		Если Файл.Существует() Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		// Нет каталога /etc — значит не Linux.
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПутьБиблиотекиИзФайла(МестоположениеПоУмолчанию)
	
	// Ищем распакованную библиотеку по маске, а не по файлу-подсказке:
	// масок не требует ручной синхронизации с CI-скриптом. Порядок: сначала
	// подкаталог addin (его создаёт ci-linux-test.sh), затем сам каталог
	// обработки — на случай, если библиотеку положили рядом.
	Маски = Новый Массив;
	Если ЭтоЛинукс() Тогда
		Маски.Добавить("addin|*Lin64*.so");
		Маски.Добавить("*Lin64*.so");
	Иначе
		Маски.Добавить("addin|*Win64*.dll");
		Маски.Добавить("*Win64*.dll");
	КонецЕсли;
	
	Для каждого Вариант Из Маски Цикл
		Попытка
			Части = СтрРазделить(Вариант, "|", Ложь);
			Каталог = ТекущийКаталог;
			Если Части.Количество() > 1 Тогда
				Каталог = ТекущийКаталог + Части[0] + "/";
			КонецЕсли;
			Найденные = НайтиФайлы(Каталог, Части[Части.Количество() - 1], Ложь);
			Если Найденные.Количество() > 0 Тогда
				ЗаписатьМаркер("библиотека найдена: " + Найденные[0].ПолноеИмя);
				Возврат Найденные[0].ПолноеИмя;
			КонецЕсли;
		Исключение
			// Маска не сработала — пробуем следующую.
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	ЗаписатьМаркер("распакованной библиотеки рядом с обработкой нет");
	Возврат МестоположениеПоУмолчанию;
	
КонецФункции

&НаКлиенте
Функция ОписаниеФайлаКомпоненты()
	
	Попытка
		Файл = Новый Файл(МестоположениеКомпоненты);
		Если Файл.Существует() Тогда
			Возврат "есть, " + Файл.Размер() + " байт";
		КонецЕсли;
		Возврат "НЕТ по пути " + Строка(МестоположениеКомпоненты);
	Исключение
		Возврат "не файл (адрес хранилища): " + Строка(МестоположениеКомпоненты);
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ПодключитьСинхронно()
	
	Попытка
		ПодключитьВнешнююКомпоненту(МестоположениеКомпоненты, ИдентификаторКомпоненты,
			ТипВнешнейКомпоненты.Native);
		ЗаписатьМаркер("синхронное подключение: успех");
		Возврат Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписатьМаркер("синхронное подключение: ошибка " + КраткоеПредставлениеОшибки(Информация));
		ЗаписатьМаркер("подробно: " + ПодробноеПредставлениеОшибки(Информация));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ЗапуститьТесты()
	
	Попытка
		СоздатьСоединение();
		ВыполнитьТесты();
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписатьМаркер("ошибка выполнения тестов: " + КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	// success.txt уже записан ВыполнитьТесты, поэтому даже если клиент не
	// успеет выйти, скрипт CI увидит успех по файлу.
	ПодключитьОбработчикОжидания("ЗавершитьРаботу", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСторож()
	
	// Асинхронное подключение на Linux может не вызвать оповещение вообще.
	// Сторож превращает зависание до таймаута CI (300 с) в понятную ошибку
	// через 120 с, с маркером в trace.log. Признак успеха — файл-маркер
	// подключения не нужен: сторож снимается в обработчике завершения.
	ПодключитьОбработчикОжидания("СторожПодключения", 120, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СторожПодключения()
	
	ЗаписатьМаркер("сторож: подключение не завершилось за 120 с");
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПодключениеВнешнейКомпоненты(ДополнительныеПараметры) Экспорт
	
	ЗаписатьМаркер("НачатьПодключение, установка=" + Строка(ДополнительныеПараметры));
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодключениеВнешнейКомпонентыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты, ИдентификаторКомпоненты, ТипВнешнейКомпоненты.Native);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключениеВнешнейКомпонентыЗавершение(Подключение, ДополнительныеПараметры) Экспорт
	
	ЗаписатьМаркер("Подключение завершено: " + Строка(Подключение));
	Если Подключение Тогда
		// Снимаем сторож, иначе он прервёт прогон на середине тестов.
		ОтключитьОбработчикОжидания("СторожПодключения");
		ЗапуститьТесты();
	ИначеЕсли ДополнительныеПараметры = Истина Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьПодключениеВнешнейКомпоненты", ЭтотОбъект, Ложь);
		НачатьУстановкуВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты);
	Иначе
		// Компонента не подключилась и после установки. Без этого сообщения
		// клиент молча висит без тестов, и в CI не видно причины.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось подключить внешнюю компоненту из макета "
			+ ИмяФайлаОбработки;
		Сообщение.Сообщить();
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботу()
	
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область МетодыПубликацииРезультатов

&НаКлиенте
Процедура СоздатьСоединение()
	
	ЧтениеТекста = Новый ЧтениеТекста(ТекущийКаталог + "app_port.txt");
	Порт = Число(ЧтениеТекста.Прочитать());
	HTTPСоединение = Новый HTTPСоединение("localhost", Порт);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщение(Сообщение, Статус, ПОдробно = "")
	
	Структура = Новый Структура;
	Структура.Вставить("message", Строка(Сообщение));
	Структура.Вставить("category", Строка(Статус));
	Структура.Вставить("details", Строка(ПОдробно));
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Структура);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	HTTPЗапрос = Новый HTTPЗапрос("/api/build/messages");
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON);
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТест(HTTPМетод, ИмяТеста, Статус, Длительность = 0, Подробно = "")
	
	Структура = Новый Структура;
	Структура.Вставить("outcome", Статус);
	Структура.Вставить("testName", ИмяТеста);
	Структура.Вставить("fileName", ИмяФайлаОбработки);
	Структура.Вставить("ErrorMessage", Подробно);
	Структура.Вставить("durationMilliseconds", Длительность);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Структура);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	HTTPЗапрос = Новый HTTPЗапрос("/api/tests");
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON);
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	HTTPСоединение.ВызватьHTTPМетод(HTTPМетод, HTTPЗапрос);
	
КонецПроцедуры

#КонецОбласти

#Область ЭкспортныеМетоды

&НаКлиенте
Процедура Добавить(Знач ИмяМетода, Знач Представление) Экспорт
	
	НаборТестов.Вставить(Представление, ИмяМетода);
	ОтправитьТест("POST", Представление, "Running");
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьШаг(ТекущаяГруппа, Представление) Экспорт
	
	Возврат Новый Структура("Наименование,Результат,Эталон", Представление);
	
КонецФункции	

&НаКлиенте
Функция ЗаписатьПроблему(ТекущаяГруппа, ТекущаяСтрока, ТекстПроблемы) Экспорт

	ЕстьПроблема = Истина;
	ЕстьОшибкиПроблемы = Истина; 
	
	Если ТекущаяСтрока = Неопределено Тогда
		Наименование = "Неизвестная проблема";
	Иначе
		Наименование = ТекущаяСтрока.Наименование;
	КонецЕсли;
	
	ОтправитьСообщение(Наименование, "Warning", ТекстПроблемы);
	
	Возврат ЭтаФорма;
	
КонецФункции

&НаКлиенте
Функция ПрерватьТест(ТекущаяГруппа, ТекущаяСтрока, Результат, Подробности) Экспорт
	
	ЕстьОшибка = Истина;
	ЕстьОшибкиПроблемы = Истина; 
	
	Если ТекущаяСтрока = Неопределено Тогда
		Наименование = "Неизвестная проблема";
	Иначе
		Наименование = ТекущаяСтрока.Наименование;
	КонецЕсли;
	
	ОтправитьСообщение(ТекущаяСтрока.Наименование, "Error", 
		Строка(Подробности) + Символы.ПС + Строка(Результат));
	
	Возврат ЭтаФорма;
	
КонецФункции

#КонецОбласти

#Область СлужебныеФункции

&НаКлиенте
Процедура ЗаписатьМаркер(Текст)
	
	// Диагностика зависаний в CI: клиент не пишет ни в /Out, ни в журнал
	// регистрации, поэтому шаги проходим маркерами в отдельном файле.
	Попытка
		Запись = Новый ЗаписьТекста(ТекущийКаталог + "trace.log", "UTF-8", , Истина);
		Запись.ЗаписатьСтроку(Текст);
		Запись.Закрыть();
	Исключение
		// Маркер — только диагностика: сбой записи не должен ронять прогон.
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьФормуПоИмени(НовоеИмя, ФормаВладелец)
	
	ПозицияРазделителя = СтрНайти(ИмяФормы, ".", НаправлениеПоиска.СКонца);
	НовоеИмяФормы = Лев(ИмяФормы, ПозицияРазделителя) + НовоеИмя;
	Возврат ПолучитьФорму(НовоеИмяФормы, Неопределено, ФормаВладелец, Новый УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьТест(ТекущийТест)
	
	ЕстьОшибка = Ложь;
	ЕстьПроблема = Ложь;
	
	xUnitBDD = ПолучитьФормуПоИмени("xUnitBDD", ЭтаФорма);
	xUnitBDD.Инициализация(ЭтотОбъект, ИдентификаторКомпоненты, ТекущийТест);
	Автотесты = ПолучитьФормуПоИмени("Autotests", xUnitBDD);
	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		Выполнить("Автотесты." + ТекущийТест.ИмяМетода + "(xUnitBDD)");
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат = КраткоеПредставлениеОшибки(Информация);
		Подробности = ПодробноеПредставлениеОшибки(Информация);
		ПрерватьТест(ТекущийТест, Неопределено, Результат, Подробности);
	КонецПопытки;
	
	Статус = ?(ЕстьОшибка ИЛИ ЕстьПроблема, "Failed", "Passed");
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтарта;
	ОтправитьТест("PUT", ТекущийТест.Наименование, Статус, Длительность);
	
КонецПроцедуры	
 
&НаКлиенте
Процедура ВыполнитьТесты()
	
	НаборТестов = Новый Соответствие;
	Автотесты = ПолучитьФормуПоИмени("Autotests", ЭтаФорма);
	Автотесты.ЗаполнитьНаборТестов(ЭтаФорма);
	
	ЕстьОшибкиПроблемы = Ложь;
	Для каждого ЭлементСписка Из НаборТестов Цикл
		ТекущийТест = Новый Структура;
		ТекущийТест.Вставить("Наименование", ЭлементСписка.Ключ);
		ТекущийТест.Вставить("ИмяМетода", ЭлементСписка.Значение);
		ВыполнитьТест(ТекущийТест);
	КонецЦикла;
	
	Если Не ЕстьОшибкиПроблемы Тогда
		ЗаписьТекста = Новый ЗаписьТекста(ТекущийКаталог + "success.txt");
		ЗаписьТекста.ЗаписатьСтроку(ТекущаяУниверсальнаяДатаВМиллисекундах());
		ЗаписьТекста.Закрыть();
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти
