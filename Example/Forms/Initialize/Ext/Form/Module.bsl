&НаКлиенте
Перем МестоположениеКомпоненты, ИдентификаторКомпоненты;
// Полученная форма тестов живёт в модульной переменной, а не в локальной:
// после возврата из процедуры локальную платформа может собрать, а вместе с ней
// умирает и форма — оповещения о подключении компоненты тогда некому принимать,
// и клиент молча стоит до таймаута.
&НаКлиенте
Перем ФормаАвтотеста;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Значения кладём в реквизиты формы (объявлены в Form.xml), а не в
	// локальные переменные: ПриОткрытии на клиенте локальные не увидит.
	AddInURL = "";
	РежимЗапуска = "";
	Автотестирование = Ложь;
	Параметры.Свойство("AddInURL", AddInURL);
	Параметры.Свойство("РежимЗапуска", РежимЗапуска);
	Параметры.Свойство("Автотестирование", Автотестирование);
	// Режим приходит от прослойки конфигурации под именем объявленного
	// параметра формы: необъявленные ключи структуры платформа не передаёт.
	Если ПустаяСтрока(РежимЗапуска) Тогда
		Параметры.Свойство("РежимЗапускаФормы", РежимЗапуска);
	КонецЕсли;
	
	ЗаписатьМаркерСервер("ПриСозданииНаСервере, РежимЗапуска=" + РежимЗапуска);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьМаркерСервер(Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "ci-trace.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("initialize: " + Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМаркер(Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "ci-trace.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("initialize: " + Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Режим приходит параметром формы от формы-прослойки конфигурации.
	// ПараметрЗапуска при программном открытии содержит служебные ключи
	// платформы, поэтому как источник режима не используется.
	ЗаписатьМаркер("ПриОткрытии, РежимЗапуска=[" + РежимЗапуска + "], Автотестирование=" + Строка(Автотестирование));
	// Ничего не открываем прямо здесь. Цепочка получается трёхуровневой:
	// ПриНачалеРаботыСистемы -> прослойка -> эта форма -> AutotestRun, и
	// вложенное открытие третьей формы из обработчика ПриОткрытии платформа до
	// конца не доводит: маркер «открываю AutotestRun» пишется, а форма не
	// создаётся и клиент стоит до таймаута. Откладываем на обработчик ожидания,
	// когда платформа закончит собственную цепочку открытия.
	ПодключитьОбработчикОжидания("ОбработатьРежимЗапуска", 0.2, Истина);
	ЗаписатьМаркер("ПриОткрытии завершён, открытие отложено");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРежимЗапуска()
	
	ОтключитьОбработчикОжидания("ОбработатьРежимЗапуска");
	ЗаписатьМаркер("ОбработатьРежимЗапуска, старт");
	РежимАвтотестирования = ТипЗнч(Автотестирование) = Тип("Булево") И Автотестирование;
	Если РежимАвтотестирования ИЛИ РежимЗапуска = "autotest" Тогда
		// Проба: заведомо простая форма обработки, без серверного кода и без
		// параметров. Если она получается, а AutotestRun нет — дело в самой
		// форме; если виснет и она — вторая форма обработки под Linux не
		// создаётся в принципе, и логику тестов надо переносить в эту форму.
		ЗаписатьМаркер("проба: получаю Autotests");
		Попытка
			ФормаПробы = ПолучитьФормуАвтотеста("Autotests");
			ЗаписатьМаркер("проба: Autotests получен");
		Исключение
			ЗаписатьМаркер("проба: Autotests - ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
		ЗаписатьМаркер("ветка autotest: получаю AutotestRun без открытия");
		// Проба 2: та же форма, но без параметров. Отделяет параметры формы от
		// серверного ПриСозданииНаСервере как причину зависания.
		ЗаписатьМаркер("проба 2: получаю AutotestRun без параметров");
		Попытка
			ПозицияТочки = СтрНайти(ИмяФормы, ".", НаправлениеПоиска.СКонца);
			ИмяБезПараметров = Лев(ИмяФормы, ПозицияТочки) + "AutotestRun";
			ФормаБезПараметров = ПолучитьФорму(ИмяБезПараметров, Неопределено);
			ЗаписатьМаркер("проба 2: AutotestRun без параметров получен");
		Исключение
			ЗаписатьМаркер("проба 2: AutotestRun без параметров - ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
		Попытка
			ФормаАвтотеста = ПолучитьФормуАвтотеста();
			ЗаписатьМаркер("AutotestRun получен, запускаю");
			ФормаАвтотеста.ЗапуститьАвтотест();
			ЗаписатьМаркер("AutotestRun запущен");
		Исключение
			ЗаписатьМаркер("AutotestRun - ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
		// Initialize не закрываем: форму тестов держит модульная переменная, а
		// закрытие последней открытой формы завершает клиентский контекст
		// обработки — вместе с ним умирают и оповещения о подключении компоненты.
	ИначеЕсли РежимЗапуска = "install" Тогда
		// Форму не закрываем: дальше идёт асинхронное подключение компоненты,
		// и его оповещения приходят в эту форму.
		ЗаписатьМаркер("ветка install: установка компоненты");
		ВыполнитьУстановкуКомпоненты();
	Иначе
		ЗаписатьМаркер("ветка по умолчанию: открываю MainForm");
		Попытка
			ОткрытьФормуПоИмени("MainForm");
			ЗаписатьМаркер("MainForm открыта, закрываю Initialize");
		Исключение
			ЗаписатьМаркер("MainForm - ОШИБКА: " + ОписаниеОшибки());
		КонецПопытки;
		Закрыть();
	КонецЕсли;
	ЗаписатьМаркер("ОбработатьРежимЗапуска завершён");
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьФормуАвтотеста(Знач ИмяФормыОбработки = "AutotestRun")

	// Форму берём, но не показываем: ОткрытьФорму второй формы внешней
	// обработки из конфигурации вешает клиент во вложенной обработке
	// idle-событий (стеки прогонов 66-69). ПолучитьФорму создаёт форму и
	// отдаёт объект, дальше вызывается её экспортная ЗапуститьАвтотест.
	ПозицияРазделителя = СтрНайти(ИмяФормы, ".", НаправлениеПоиска.СКонца);
	НовоеИмяФормы = Лев(ИмяФормы, ПозицияРазделителя) + ИмяФормыОбработки;
	Если ИмяФормыОбработки = "AutotestRun" Тогда
		ПараметрыФормы = Новый Структура("Автотестирование,AddInURL", Истина, AddInURL);
	Иначе
		ПараметрыФормы = Неопределено;
	КонецЕсли;
	Возврат ПолучитьФорму(НовоеИмяФормы, ПараметрыФормы);

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуПоИмени(НовоеИмя, Автотестирование = Ложь)
	
	ПараметрыФормы = Новый Структура("Автотестирование,AddInURL", Автотестирование, AddInURL);
	ПозицияРазделителя = СтрНайти(ИмяФормы, ".", НаправлениеПоиска.СКонца);
	НовоеИмяФормы = Лев(ИмяФормы, ПозицияРазделителя) + НовоеИмя;
	ОткрытьФорму(НовоеИмяФормы, ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМестоположениеКомпоненты()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МакетКомпоненты = ОбработкаОбъект.ПолучитьМакет("VanessaExt");
	Возврат ПоместитьВоВременноеХранилище(МакетКомпоненты, УникальныйИдентификатор);
	
КонецФункции	

&НаКлиенте
Процедура ВыполнитьУстановкуКомпоненты()
	
	МестоположениеКомпоненты = ПолучитьМестоположениеКомпоненты();
	ИдентификаторКомпоненты = "_" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверкаПодключенияВнешнейКомпоненты", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты, ИдентификаторКомпоненты, ТипВнешнейКомпоненты.Native);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПодключенияВнешнейКомпоненты(Подключение, ДополнительныеПараметры) Экспорт
	
	Если Подключение Тогда
		ЗавершитьРаботуСистемы(Ложь);
	Иначе
		НачатьУстановкуВнешнейКомпоненты(Новый ОписаниеОповещения, МестоположениеКомпоненты);
		ПодключитьОбработчикОжидания("ПослеУстановкиВнешнейКомпоненты", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиВнешнейКомпоненты()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьЗавершениеРаботыСистемы", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты, ИдентификаторКомпоненты, ТипВнешнейКомпоненты.Native);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗавершениеРаботыСистемы(Подключение, ДополнительныеПараметры) Экспорт
	
	ВнешняяКомпонента = Новый("AddIn." + ИдентификаторКомпоненты + ".WindowsControl");
	ВнешняяКомпонента.НачатьВызовЗавершитьРаботуСистемы(Новый ОписаниеОповещения, 0);
	
КонецПроцедуры
