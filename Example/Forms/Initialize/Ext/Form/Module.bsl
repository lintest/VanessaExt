&НаКлиенте
Перем МестоположениеКомпоненты, ИдентификаторКомпоненты;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Значения кладём в реквизиты формы (объявлены в Form.xml), а не в
	// локальные переменные: ПриОткрытии на клиенте локальные не увидит.
	AddInURL = "";
	РежимЗапуска = "";
	Автотестирование = Ложь;
	Параметры.Свойство("AddInURL", AddInURL);
	Параметры.Свойство("РежимЗапуска", РежимЗапуска);
	Параметры.Свойство("Автотестирование", Автотестирование);
	// Режим приходит от прослойки конфигурации под именем объявленного
	// параметра формы: необъявленные ключи структуры платформа не передаёт.
	Если ПустаяСтрока(РежимЗапуска) Тогда
		Параметры.Свойство("РежимЗапускаФормы", РежимЗапуска);
	КонецЕсли;
	
	ЗаписатьМаркерСервер("ПриСозданииНаСервере, РежимЗапуска=" + РежимЗапуска);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьМаркерСервер(Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "ci-trace.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("initialize: " + Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМаркер(Знач Текст)
	
	Попытка
		Запись = Новый ЗаписьТекста(КаталогВременныхФайлов() + "ci-trace.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку("initialize: " + Текст);
		Запись.Закрыть();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Режим приходит параметром формы от формы-прослойки конфигурации.
	// ПараметрЗапуска при программном открытии содержит служебные ключи
	// платформы, поэтому как источник режима не используется.
	ЗаписатьМаркер("ПриОткрытии, РежимЗапуска=[" + РежимЗапуска + "], Автотестирование=" + Строка(Автотестирование));
	РежимАвтотестирования = ТипЗнч(Автотестирование) = Тип("Булево") И Автотестирование;
	Если РежимАвтотестирования ИЛИ РежимЗапуска = "autotest" Тогда
		ЗаписатьМаркер("ветка autotest: открываю AutotestRun");
		ОткрытьФормуПоИмени("AutotestRun", Истина);
		Отказ = Истина;
	ИначеЕсли РежимЗапуска = "install" Тогда
		ЗаписатьМаркер("ветка install: установка компоненты");
		ВыполнитьУстановкуКомпоненты();
		Отказ = Ложь;
	Иначе
		ЗаписатьМаркер("ветка по умолчанию: открываю MainForm");
		ОткрытьФормуПоИмени("MainForm");
		Отказ = Истина;
	КонецЕсли;
	ЗаписатьМаркер("ПриОткрытии завершён, Отказ=" + Строка(Отказ));
	

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПоИмени(НовоеИмя, Автотестирование = Ложь)
	
	ПараметрыФормы = Новый Структура("Автотестирование,AddInURL", Автотестирование, AddInURL);
	ПозицияРазделителя = СтрНайти(ИмяФормы, ".", НаправлениеПоиска.СКонца);
	НовоеИмяФормы = Лев(ИмяФормы, ПозицияРазделителя) + НовоеИмя;
	ОткрытьФорму(НовоеИмяФормы, ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМестоположениеКомпоненты()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МакетКомпоненты = ОбработкаОбъект.ПолучитьМакет("VanessaExt");
	Возврат ПоместитьВоВременноеХранилище(МакетКомпоненты, УникальныйИдентификатор);
	
КонецФункции	

&НаКлиенте
Процедура ВыполнитьУстановкуКомпоненты()
	
	МестоположениеКомпоненты = ПолучитьМестоположениеКомпоненты();
	ИдентификаторКомпоненты = "_" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверкаПодключенияВнешнейКомпоненты", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты, ИдентификаторКомпоненты, ТипВнешнейКомпоненты.Native);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаПодключенияВнешнейКомпоненты(Подключение, ДополнительныеПараметры) Экспорт
	
	Если Подключение Тогда
		ЗавершитьРаботуСистемы(Ложь);
	Иначе
		НачатьУстановкуВнешнейКомпоненты(Новый ОписаниеОповещения, МестоположениеКомпоненты);
		ПодключитьОбработчикОжидания("ПослеУстановкиВнешнейКомпоненты", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеУстановкиВнешнейКомпоненты()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьЗавершениеРаботыСистемы", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(ОписаниеОповещения, МестоположениеКомпоненты, ИдентификаторКомпоненты, ТипВнешнейКомпоненты.Native);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗавершениеРаботыСистемы(Подключение, ДополнительныеПараметры) Экспорт
	
	ВнешняяКомпонента = Новый("AddIn." + ИдентификаторКомпоненты + ".WindowsControl");
	ВнешняяКомпонента.НачатьВызовЗавершитьРаботуСистемы(Новый ОписаниеОповещения, 0);
	
КонецПроцедуры
